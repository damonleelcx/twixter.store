# PostgreSQL 数据库配置
# 复制此文件为 .env 并修改相应的配置值

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_PORT=5432
DB_SSLMODE=disable

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Sentry 错误监控配置
# 从 Sentry 项目设置中获取 DSN
# 格式: https://<key>@<organization>.ingest.sentry.io/<project-id>
SENTRY_DSN=

# AWS S3 配置（用于视频上传）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Kafka 配置
KAFKA_BROKERS=localhost:9092

# Stripe 支付配置
# 从 Stripe Dashboard (https://dashboard.stripe.com/apikeys) 获取密钥
# 测试环境使用 sk_test_...，生产环境使用 sk_live_...
STRIPE_SECRET_KEY=
# Stripe Webhook Secret（从 Stripe Dashboard Webhooks 设置中获取）
# 格式: whsec_...
STRIPE_WEBHOOK_SECRET=

# 前端 URL（用于 Stripe Checkout 返回 URL）
FRONTEND_URL=http://localhost:3000

# FFmpeg 配置（可选，如果未设置则使用系统 PATH 中的 ffmpeg/ffprobe）
# 如果 FFmpeg 不在系统 PATH 中，请指定完整路径
FFMPEG_PATH=
FFPROBE_PATH=

# 视频处理临时目录
TEMP_DIR=/tmp/video-processing

VIEWING_TOKEN_SECRET=your-secret-at-least-16-chars



SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=