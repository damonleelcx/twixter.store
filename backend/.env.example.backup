# PostgreSQL 数据库配置
# 复制此文件为 .env 并修改相应的配置值

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_PORT=5432
DB_SSLMODE=disable

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Sentry 错误监控配置
# 从 Sentry 项目设置中获取 DSN
# 格式: https://<key>@<organization>.ingest.sentry.io/<project-id>
SENTRY_DSN=
