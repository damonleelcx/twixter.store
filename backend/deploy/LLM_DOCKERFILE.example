# 自托管 LLM 推理镜像示例（llama.cpp server）
# 将模型文件放到 ./models/model.gguf，构建后运行在 8081 端口
# 使用：docker build -f backend/deploy/LLM_DOCKERFILE.example -t yourrepo/llm:latest .

FROM ghcr.io/ggerganov/llama.cpp:latest

COPY ./models /models
EXPOSE 8081

CMD ["./server", "-m", "/models/model.gguf", "--port", "8081"]
